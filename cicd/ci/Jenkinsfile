    //                 def maxRetries = 5
    //                 def retryCount = 0
    //                 def success = false

    //                 // Retry logic for health check
    //                 while (retryCount < maxRetries && !success) {
    //                     echo "Health check attempt ${retryCount + 1}/${maxRetries}..."

    //                     // Try each URL
    //                     for (def healthUrl in healthUrls) {
    //                         try {
    //                             echo "Trying health check URL: ${healthUrl}"

    //                             def response = sh(script: "curl -s --connect-timeout 5 ${healthUrl}", returnStdout: true).trim()

    //                             if (response) {
    //                                 echo "Response from health check API: ${response}"

    //                                 try {
    //                                     def jsonResponse = readJSON text: response
    //                                     if (jsonResponse.status == 'UP') {
    //                                         echo "Health check passed: Application is healthy at ${healthUrl}"
    //                                         success = true
    //                                         break  // Exit the URL loop if successful
    //                                     } else {
    //                                         echo "Health check returned status: ${jsonResponse.status}"
    //                                     }
    //                                 } catch (Exception e) {
    //                                     echo "Error parsing JSON response: ${e.message}"
    //                                 }
    //                             } else {
    //                                 echo "Empty response from health check at ${healthUrl}"

    //                 if (!success) {
    //                     // As a last resort, check if the container is actually running
    //                     def containerRunning = sh(script: "docker ps -q -f name=exchangerates-container", returnStdout: true).trim()

    //                     if (containerRunning) {
    //                         echo "Container is running but health check failed. Container logs:"
    //                         sh "docker logs exchangerates-container"

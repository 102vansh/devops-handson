pipeline {
    agent any

    environment {
        GITHUB_CREDENTIALS_ID = 'github-token'
        REPO_URL = 'https://github.com/102vansh/devops-handson.git'
        SONAR_AUTH_TOKEN = credentials('sonarqube')
        DOCKER_CREDENTIALS_ID = 'dockerhub-credentials'

        // Use credentials to dynamically set the image name based on the Docker Hub username
        DOCKER_HUB_CREDENTIALS = credentials('dockerhub-credentials')
        IMAGE_NAME = "${DOCKER_HUB_CREDENTIALS_USR}/exchangerates"

        //following is not required. You can skip.
        GRADLE_HOME = '/opt/gradle'
        PATH = "$GRADLE_HOME/bin:$PATH"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/new-main']],
                        userRemoteConfigs: [
                            [
                                url: REPO_URL,
                                credentialsId: GITHUB_CREDENTIALS_ID
                            ]
                        ]
                    ])
                }
            }
        }

        stage('Setup JDK 17') {
            steps {
                script {
                    sh '''
                        echo "Installing OpenJDK 17..."
                        apt-get update
                        apt-get install -y openjdk-17-jdk
                        java -version
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    sh './gradlew build -x test -x runSmokeTest'
                }
            }
        }

        stage('Unit Test') {
            steps {
                script {
                    sh './gradlew test'
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    sh './gradlew runSmokeTest'
                }
            }
        }

        // stage('Code Analysis') {
        //     steps {
        //         script {
        //             withSonarQubeEnv('SonarQube') {
        //                 sh './gradlew sonar -Dsonar.login=$SONAR_AUTH_TOKEN'
        //             }

        //             def qualityGate = waitForQualityGate()
        //             if (qualityGate.status != 'OK') {
        //                 error "SonarQube Quality Gate failed: ${qualityGate.status}"
        //             } else {
        //                 echo "SonarQube Quality Gate passed."
        //             }
        //         }
        //     }
        // }

        stage('Build and Push docker image') {
            steps {
                script {
                    def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                    // Define the Docker image tag as the commit hash
                    def imageTag = "${commitHash}"

                    echo "Image tag : ${imageTag}"

                    def imageNameWithTag = "${IMAGE_NAME}:${imageTag}"

                    echo "Image name with tag : ${imageNameWithTag}"

                    echo "Push image in docker hub"

                    // Try a different approach for Docker Hub authentication
                    withCredentials([usernamePassword(credentialsId: DOCKER_CREDENTIALS_ID, usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                        // First login to Docker Hub securely
                        sh '''
                            echo "Logging in to Docker Hub as $DOCKER_USERNAME..."
                            echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin
                        '''

                        // Then build and push the image
                        sh """
                            echo "Building Docker image ${imageNameWithTag}..."
                            docker build -t ${imageNameWithTag} .

                            echo "Pushing Docker image to Docker Hub..."
                            docker push ${imageNameWithTag}

                            # If the above fails, try with the full registry URL
                            if [ \$? -ne 0 ]; then
                                echo "First push attempt failed, trying with full registry URL..."
                                docker tag ${imageNameWithTag} docker.io/${imageNameWithTag}
                                docker push docker.io/${imageNameWithTag}
                            fi
                        """
                    }

                    env.COMMIT_HASH = commitHash
                }
            }
        }

        stage('Deploy on Dev') {
            steps {
                script {
                    def containerName = "exchangerates-container"
                    def imageTag = env.COMMIT_HASH

                    // Check for and remove any container with the same name, whether running or not
                    sh """
                        # Check for running containers with this name
                        if [ \$(docker ps -q -f name=${containerName}) ]; then
                            echo "Stopping running container ${containerName}..."
                            docker stop ${containerName} || true
                        fi

                        # Check for any container with this name (running or stopped)
                        if [ \$(docker ps -a -q -f name=${containerName}) ]; then
                            echo "Removing container ${containerName}..."
                            docker rm -f ${containerName} || true
                        fi
                    """

                    // Run the new container with more robust port handling
                    sh """
                        echo "Running new container with image tag ${imageTag}..."

                        # Check if port 8095 is already in use and kill any process using it
                        PORT=8095

                        # Find and kill any process using port 8095
                        if command -v lsof >/dev/null 2>&1; then
                            # If lsof is available
                            PORT_PID=\$(lsof -ti:\$PORT)
                            if [ ! -z "\$PORT_PID" ]; then
                                echo "Port \$PORT is in use by process \$PORT_PID. Killing it..."
                                kill -9 \$PORT_PID || true
                            fi
                        elif command -v netstat >/dev/null 2>&1; then
                            # If netstat is available
                            PORT_PID=\$(netstat -tulpn 2>/dev/null | grep ":\$PORT " | awk '{print \$7}' | cut -d'/' -f1)
                            if [ ! -z "\$PORT_PID" ]; then
                                echo "Port \$PORT is in use by process \$PORT_PID. Killing it..."
                                kill -9 \$PORT_PID || true
                            fi
                        fi

                        # Check for any Docker containers using this port and stop them
                        CONTAINER_IDS=\$(docker ps -q --filter publish=\$PORT)
                        if [ ! -z "\$CONTAINER_IDS" ]; then
                            echo "Found containers using port \$PORT. Stopping them..."
                            for CID in \$CONTAINER_IDS; do
                                echo "Stopping and removing container \$CID..."
                                docker stop \$CID || true
                                docker rm \$CID || true
                            done
                        fi

                        # Double-check that the port is actually free now
                        if lsof -i :\$PORT > /dev/null 2>&1 || netstat -tuln 2>/dev/null | grep -q ":\$PORT "; then
                            echo "Warning: Port \$PORT is still in use after cleanup attempts"
                        else
                            echo "Port \$PORT is now available"
                        fi

                        # Now run the new container
                        docker run -d --name ${containerName} -p \$PORT:8080 ${IMAGE_NAME}:${imageTag}

                        echo "Container started on port \$PORT"
                    """
                }
            }
        }

        stage('Health check on Dev') {
            steps {
                script {
                    echo "Performing health check on Docker container..."

                    // Wait for the application to start up
                    sleep(time: 15, unit: "SECONDS")

                    def healthUrl = "http://host.docker.internal:8095/actuator/health"
                    def maxRetries = 5
                    def retryCount = 0
                    def success = false

                    // Retry logic for health check
                    while (retryCount < maxRetries && !success) {
                        try {
                            echo "Health check attempt ${retryCount + 1}/${maxRetries}..."

                            def response = sh(script: "curl -s ${healthUrl}", returnStdout: true).trim()
                            echo "Response from health check API: ${response}"

                            if (response) {
                                def jsonResponse = readJSON text: response
                                def status = jsonResponse.status

                                echo "Health Status: ${status}"

                                if (status == 'UP') {
                                    echo 'Health check passed: Application is healthy.'
                                    success = true
                                } else {
                                    echo "Health check returned status: ${status}, retrying..."
                                    sleep(time: 10, unit: "SECONDS")
                                }
                            } else {
                                echo "Empty response from health check, retrying..."
                                sleep(time: 10, unit: "SECONDS")
                            }
                        } catch (Exception e) {
                            echo "Error during health check: ${e.message}, retrying..."
                            sleep(time: 10, unit: "SECONDS")
                        }

                        retryCount++
                    }

                    if (!success) {
                        error "Health check failed after ${maxRetries} attempts"
                    }

                }
            }
        }

        stage('Update image tag') {
            steps {
                script {
                    def imageTag = env.COMMIT_HASH

                     sh 'git checkout new-main'

                    // Use 'sed' to replace the image tag in values.yaml
                    sh """
                        sed -i 's/tag:.*/tag: ${imageTag}/' k8chart/values.yaml
                    """

                    withCredentials([
                        gitUsernamePassword(credentialsId: GITHUB_CREDENTIALS_ID, gitToolName: 'Default')
                    ]) {
                        sh """
                             git config user.email "kodedge-bot-ci@kodedge.com"
                             git config user.name "kodedge-bot-ci"
                             git add k8chart/values.yaml
                             git commit -m "Update image tag to version ${imageTag}"
                             git push origin new-main
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Clean up workspace after build'
            cleanWs()
        }

        success {
            echo 'Pipeline successful!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}
